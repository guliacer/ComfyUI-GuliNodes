+        self.assertEqual(pe._run(kwargs), "测试增强")
+        self.assertIsNotNone(retained._process.poll())
+        self.assertIsNone(pe._LocalLLMStorage.llm)
+        self.assertIsNone(pe._LocalLLMStorage.key)
