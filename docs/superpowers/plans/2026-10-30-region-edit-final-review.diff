+        self.assertIsNone(pe._LocalLLMStorage.key)
+        fresh = pe._LocalLLMStorage.load("query_eof", "无", 4096)
+        self.assertIsNot(fresh, dead)
+        self.assertIsNone(fresh._process.poll())
+
+
+if __name__ == "__main__":
+    unittest.main()

