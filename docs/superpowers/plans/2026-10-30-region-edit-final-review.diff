+        self.assertEqual(self.source(roles["person_restore"], "背景图像", links), expected)
+        self.assertEqual(self.source(roles["person_merge"], "背景图", links), expected)
+
+    def test_empty_requests_lazily_skip_entire_region_branch(self):
